<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.yokozurashi.steps"
    android:versionCode="22"
    android:versionName="0.22">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <!-- ヘルスコネクトの歩数を読む許可。2つめは、アプリを開いていないときにも読むためのもの -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 設定画面。地図の画面の右上の歯車から開く -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="設定" />

        <!-- ウィジェットの更新マークで開く、見えない画面。歩数を読んだらすぐ閉じる。
             アプリの画面とは別のタスクで開き（taskAffinity が空）、最近使ったアプリにも出さない -->
        <activity
            android:name=".ReloadActivity"
            android:exported="false"
            android:theme="@style/Reload"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleTask" />

        <!-- ヘルスコネクトの許可の画面から「このアプリがデータを使う理由」を開くときの入口。
             これがないと、Android 14 以上で許可を求められない -->
        <activity-alias
            android:name=".ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".SettingsActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".StepWidgetProvider"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="app.yokozurashi.steps.REFRESH" />
                <action android:name="app.yokozurashi.steps.DAY_TICK" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <receiver
            android:name=".SystemEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".StepJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
